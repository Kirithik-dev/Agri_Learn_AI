# AGRI-LEARN AI Environment Configuration
# INTELLIX: LLM & AI Optimization Hackathon (Team Syntax Soldiers - BIT-AI-002)

# LLM Configuration
# Set LLM_PROVIDER to "demo", "gemini", "openai", or "groq"
LLM_PROVIDER=demo
LLM_API_KEY=
MODEL_NAME=gemini-1.5-flash

# Optional OpenAI / Groq keys if using those providers:
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Knowledge Base & Vector Store
DATA_DIR=../data
DB_PATH=../data/agri_learn.db
VECTOR_STORE_DIR=../data/vectorstore
DOCUMENTS_DIR=../data/documents
